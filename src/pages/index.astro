---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead 
			title={SITE_TITLE} 
			description={SITE_DESCRIPTION}
			keywords="fotografía Talagante, carnet, visa, revelado digital, rollos analógicos, estudio fotográfico"
		/>
	</head>
	<body style="background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);">
		<Header />
		<main>
			<section class="hero">
				<div class="hero-content">
					<h1 class="hero-title">Bienvenidos a Banda Fotográfica</h1>
					<p class="hero-subtitle">El mejor lugar para inmortalizar tus recuerdos</p>
					<div class="hero-cta">
						<a href="/contacto" class="cta-button primary">Contáctanos</a>
						<a href="/quienes-somos" class="cta-button secondary">Nuestros Servicios</a>
					</div>
				</div>
				<div class="hero-overlay"></div>
			</section>

			<section class="featured">
				<div class="section-header">
					<h2 class="section-title">¡Mira nuestra información!</h2>
					<p class="section-subtitle">Descubre todo lo que tenemos para ofrecerte</p>
				</div>
				<div class="cards-grid">
					<a href="/donde-encontrarnos" class="info-card location-card">
						<div class="card-image">
							<img src="/viajero-buscando.avif" alt="Ubicación del local" loading="lazy" />
							<div class="card-overlay">
								<span class="card-icon">📍</span>
							</div>
						</div>
						<div class="card-content">
							<h3 class="card-title">¿Dónde nos encontramos?</h3>
							<p class="card-description">Échale un vistazo a nuestra ubicación en el corazón de Talagante</p>
							<span class="card-action">Ver ubicación →</span>
						</div>
					</a>

					<a href="/horario" class="info-card schedule-card">
						<div class="card-image">
							<img src="/horario.jpg" alt="Horarios de atención" loading="lazy" />
							<div class="card-overlay">
								<span class="card-icon">🕒</span>
							</div>
						</div>
						<div class="card-content">
							<h3 class="card-title">¿Cuándo Atendemos?</h3>
							<p class="card-description">Consulta nuestros horarios de atención y días disponibles</p>
							<span class="card-action">Ver horarios →</span>
						</div>
					</a>

					<a href="/contacto" class="info-card contact-card">
						<div class="card-image">
							<img src="/contacto.jpg" alt="Contacto" loading="lazy" />
							<div class="card-overlay">
								<span class="card-icon">📞</span>
							</div>
						</div>
						<div class="card-content">
							<h3 class="card-title">Contacto</h3>
							<p class="card-description">¡Mira nuestras opciones de contacto y comunícate con nosotros!</p>
							<span class="card-action">Contactar →</span>
						</div>
					</a>

					<a href="/quienes-somos" class="info-card services-card">
						<div class="card-image">
							<img src="/Impresora.jpg" alt="Nuestros servicios" loading="lazy" />
							<div class="card-overlay">
								<span class="card-icon">📸</span>
							</div>
						</div>
						<div class="card-content">
							<h3 class="card-title">¿Quiénes Somos?</h3>
							<p class="card-description">Conoce nuestra historia y los servicios profesionales que ofrecemos</p>
							<span class="card-action">Conocer más →</span>
						</div>
					</a>
				</div>
			</section>

			<section class="features">
				<div class="section-header">
					<h2 class="section-title">¿Por qué elegirnos?</h2>
				</div>
				<div class="features-grid">
					<div class="feature-item">
						<div class="feature-icon">⚡</div>
						<h3>Servicio Rápido</h3>
						<p>Atención eficiente y resultados en tiempo récord</p>
					</div>
					<div class="feature-item">
						<div class="feature-icon">💝</div>
						<h3>Precios Justos</h3>
						<p>Tarifas competitivas sin comprometer la calidad</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ===== HERO SECTION ===== */
	.hero {
		position: relative;
		min-height: clamp(400px, 60vh, 600px);
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, rgba(242, 234, 5, 0.9), rgba(255, 0, 0, 0.8)), 
					url('/revelado.avif');
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
		color: white;
		margin: -3rem -2rem 3rem -2rem;
		border-radius: 0 0 2rem 2rem;
		overflow: hidden;
	}

	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, rgba(39, 39, 39, 0.3), rgba(255, 0, 0, 0.2));
		z-index: 1;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: 800px;
		padding: 2rem;
		animation: fadeInUp 1s ease-out;
	}

	.hero-title {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
		margin-bottom: 1rem;
		color: white;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
		background: none;
		-webkit-text-fill-color: white;
	}

	.hero-subtitle {
		font-size: clamp(1.2rem, 4vw, 1.8rem);
		margin-bottom: 2rem;
		color: rgba(255, 255, 255, 0.95);
		text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		padding: 1rem 2rem;
		border-radius: 50px;
		font-weight: 700;
		text-decoration: none;
		transition: all 0.3s ease;
		min-width: 160px;
		justify-content: center;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
	}

	.cta-button.primary {
		background: var(--primary-red);
		color: white;
	}

	.cta-button.primary:hover {
		background: var(--red-dark);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(255, 0, 0, 0.4);
	}

	.cta-button.secondary {
		background: var(--primary-yellow);
		color: var(--raisin-black);
	}

	.cta-button.secondary:hover {
		background: var(--yellow-dark);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(242, 234, 5, 0.4);
	}

	/* ===== SECTIONS ===== */
	.featured, .features {
		margin: 2rem 0;
	}

	.section-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.section-title {
		font-size: clamp(2rem, 5vw, 3rem);
		margin-bottom: 1rem;
		background: linear-gradient(135deg, var(--primary-red), var(--primary-yellow));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.section-subtitle {
		font-size: clamp(1rem, 3vw, 1.3rem);
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0 auto;
	}

	/* ===== CARDS GRID ===== */
	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	/* MacBook Pro and medium screens: exactly 2 columns */
	@media (min-width: 768px) and (max-width: 1099px) {
		.cards-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
	}

	/* MacBook Pro 13" and similar (1440x900): 4 columns layout */
	@media (min-width: 1100px) and (max-width: 1199px) {
		.cards-grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
		}

		.card-content {
			padding: 1rem;
		}

		.card-title {
			font-size: 1.1rem;
		}

		.card-description {
			font-size: 0.9rem;
			line-height: 1.5;
		}

		.card-action {
			font-size: 0.85rem;
		}
	}

	/* Desktop optimization: 4 columns layout */
	@media (min-width: 1200px) {
		.cards-grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 1.25rem;
		}
	}

	/* Extra large screens: maintain 4 columns with max width */
	@media (min-width: 1400px) {
		.cards-grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 1.5rem;
			max-width: 1200px;
			margin: 2rem auto 0;
		}
	}

	/* ===== INFO CARD STYLES ===== */
	.info-card {
		background: #FFFFFF;
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 4px 15px rgba(39, 39, 39, 0.1);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		text-decoration: none;
		color: #000000;
		border: 1px solid rgba(0, 0, 0, 0.1);
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.info-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 25px rgba(39, 39, 39, 0.15);
	}

	.card-image {
		position: relative;
		height: 180px;
		overflow: hidden;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.info-card:hover .card-image img {
		transform: scale(1.05);
	}

	.card-overlay {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: rgba(255, 255, 255, 0.8); /* Slightly less opaque for subtlety */
		border-radius: 50%;
		width: 40px; /* Adjusted size */
		height: 40px; /* Adjusted size */
		display: flex;
		align-items: center;
		justify-content: center;
		/* backdrop-filter: blur(5px); -- Optional: removed for wider compatibility/simplicity */
	}

	.card-icon {
		font-size: 1.25rem; /* Adjusted size */
	}

	.card-content {
		padding: 1.25rem;
		background: #FFFFFF;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-title {
		font-size: 1.2rem;
		margin-bottom: 0.5rem;
		color: #000000; 
		font-weight: 600;
		line-height: 1.3;
	}

	.card-description {
		color: #333333; 
		margin-bottom: 1rem;
		line-height: 1.6;
		flex-grow: 1;
	}

	.card-action {
		color: var(--primary-red);
		font-weight: 600;
		font-size: 0.9rem;
		transition: color 0.3s ease;
		margin-top: auto;
		align-self: flex-start;
	}

	.info-card:hover .card-action {
		color: var(--red-dark);
	}

	/* ===== FEATURES SECTION ===== */
	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	/* ===== FEATURE ITEM STYLES ===== */
	.feature-item {
		text-align: center;
		padding: 2rem 1rem;
		background: #FFFFFF;
		border-radius: 1rem;
		box-shadow: 0 4px 15px rgba(39, 39, 39, 0.1);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		border: 1px solid rgba(0, 0, 0, 0.1);
	}

	.feature-item:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 25px rgba(39, 39, 39, 0.15);
	}

	.feature-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		display: block;
	}

	.feature-item h3 {
		color: #000000; 
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.feature-item p {
		color: #333333; 
		line-height: 1.6;
	}

	/* ===== ANIMATIONS ===== */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ===== RESPONSIVE DESIGN ===== */
	@media (max-width: 768px) {
		.hero {
			margin: -1rem -1rem 2rem -1rem;
			border-radius: 0 0 1rem 1rem;
			background-attachment: scroll;
		}

		.hero-content {
			padding: 1rem;
		}

		.hero-cta {
			flex-direction: column;
			align-items: center;
		}

		.cta-button {
			width: 100%;
			max-width: 280px;
		}

		.cards-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.features-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.feature-item {
			padding: 1.5rem 1rem;
		}
	}

	@media (max-width: 480px) {
		.hero-title {
			font-size: 2rem;
		}

		.hero-subtitle {
			font-size: 1rem;
		}

		.section-title {
			font-size: 1.8rem;
		}

		.card-content {
			padding: 1rem;
		}
	}

	/* ===== ACCESSIBILITY ===== */
	@media (prefers-reduced-motion: reduce) {
		.hero-content {
			animation: none;
		}

		.info-card, .feature-item {
			transition: none;
		}

		.hero {
			background-attachment: scroll;
		}
	}

	/* ===== HIGH CONTRAST MODE ===== */
	@media (prefers-contrast: high) {
		.info-card, .feature_item {
			background: #FFFFFF;
			border: 2px solid #000000;
		}
		
		.card-title, .feature-item h3 {
			color: #000000;
		}
		
		.card-description, .feature-item p {
			color: #000000;
		}
		.card-overlay {
			background: #FFFFFF;
			border: 1px solid #000000;
		}
	}
</style>