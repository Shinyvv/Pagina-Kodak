---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Servicios - ${SITE_TITLE}`} description="Descubre los servicios profesionales que ofrecemos" />
	</head>
	<body> {/* Removed inline styles, will be handled in <style> */}
		<Header />
		<main class="main-content">
			<div class="hero-section">
				<h1>Nuestros Servicios</h1>
				<p class="subtitle">Descubre la calidad y profesionalismo en cada uno de nuestros servicios</p>
			</div>
			<div class="services-container">
				<div class="service-card">
					<h2>📸 Fotografías Profesionales</h2>
					<ul>
						<li>Fotografía para Permisos</li>
						<li>Fotografía tipo Visa</li>
						<li>Fotografía tipo carnet</li>
					</ul>
				</div>

				<div class="service-card">
					<h2>🖼️ Revelado y Edición</h2>
					<ul>
						<li>Revelado digital de alta calidad</li>
						<li>Retoque profesional</li>
						<li>Restauración de fotografías antiguas</li>
					</ul>
				</div>

				<div class="service-card">
					<h2>🎞️ Servicios Analógicos</h2>
					<ul>
						<li>Revelado de rollos </li>
						<li>Digitalización de negativos</li>
						<li>Venta de material analógico (Roollos) </li>
					</ul>
				</div>

				<div class="service-card">
					<h2>🖨️ Impresión Profesional</h2>
					<ul>
						<li>Impresión en diferentes formatos</li>
						<li>Fotografías en alta resolución</li>
						<li>Productos personalizados</li>
						<li>Enmarcado profesional</li>
					</ul>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
		margin: 0;
		color: #1f2937;
		line-height: 1.6;
	}

	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem 1rem 1rem;
		width: 100%;
	}

	/* Hero Section */
	.hero-section {
		text-align: center;
		margin-bottom: 3rem;
		width: 100%;
	}

	.hero-section h1 {
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #dc2626, #f59e0b);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-weight: bold;
	}

	.subtitle {
		font-size: clamp(1.1rem, 3vw, 1.3rem);
		color: #6b7280;
		margin: 0;
		max-width: 600px;
		margin: 0 auto;
	}

	.services-container {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		grid-auto-rows: 1fr;
		gap: 2rem;
		max-width: 1200px;
		width: 100%;
		padding: 1rem;
		align-items: stretch;
	}

	/* ===== SERVICE CARD STYLES ===== */
	.service-card {
		background: #FFFFFF;
		border-radius: 1rem;
		padding: 2rem;
		box-shadow: 0 4px 15px rgba(39, 39, 39, 0.1);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		border: 1px solid rgba(0, 0, 0, 0.1);
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.service-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 25px rgba(39, 39, 39, 0.15);
	}

	.service-card h2 {
		margin-top: 0;
		margin-bottom: 1.5rem;
		color: #1f2937; 
		font-size: 1.4rem;
		font-weight: 600;
		line-height: 1.3;
		text-align: center;
		padding-bottom: 1rem;
		border-bottom: 2px solid #f3f4f6;
		flex-shrink: 0;
	}

	.service-card ul {
		list-style-type: none;
		padding-left: 0;
		margin: 0;
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
	}

	.service-card li {
		padding: 0.75rem 0;
		border-bottom: 1px solid #f0f0f0;
		display: flex;
		align-items: flex-start;
		color: #374151;
		font-size: 0.95rem;
		line-height: 1.4;
		position: relative;
		padding-left: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.service-card li:last-child {
		border-bottom: none;
		margin-bottom: 0;
	}

	.service-card li::before {
		content: "●";
		color: #dc2626;
		font-weight: bold;
		position: absolute;
		left: 0;
		top: 0.75rem;
		font-size: 0.8rem;
	}

	/* ===== RESPONSIVE DESIGN ===== */
	/* Desktop grande (>1440px) */
	@media (min-width: 1441px) {
		.services-container {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: 1fr;
			gap: 2.5rem;
			padding: 1.5rem;
		}
		
		.service-card {
			padding: 2.5rem;
		}
		
		.service-card h2 {
			font-size: 1.5rem;
			margin-bottom: 2rem;
		}
		
		.service-card li {
			padding: 1rem 0;
			font-size: 1rem;
			padding-left: 1.75rem;
			margin-bottom: 0.75rem;
		}
	}

	/* MacBook Pro 13" (1440px) y pantallas similares */
	@media (max-width: 1440px) and (min-width: 1200px) {
		.services-container {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: 1fr;
			gap: 1.75rem;
			padding: 1.25rem;
		}
		
		.service-card {
			padding: 2rem;
		}
		
		.service-card h2 {
			font-size: 1.35rem;
		}
		
		.service-card li {
			font-size: 0.9rem;
			margin-bottom: 0.5rem;
		}
	}

	/* Laptops medianas y tablets landscape */
	@media (max-width: 1199px) and (min-width: 992px) {
		.services-container {
			grid-template-columns: repeat(3, 1fr);
			grid-auto-rows: 1fr;
			gap: 2rem;
		}
		
		.service-card {
			padding: 2rem;
		}
		
		.service-card h2 {
			font-size: 1.3rem;
		}
		
		.service-card li {
			margin-bottom: 0.5rem;
		}
	}

	/* Tablets */
	@media (max-width: 991px) and (min-width: 769px) {
		.services-container {
			grid-template-columns: repeat(2, 1fr);
			grid-auto-rows: 1fr;
			gap: 2rem;
		}
		
		.service-card {
			padding: 2rem;
		}
		
		.service-card h2 {
			font-size: 1.25rem;
		}
		
		.service-card li {
			font-size: 0.9rem;
			margin-bottom: 0.5rem;
		}
	}

	/* Mobile */
	@media (max-width: 768px) {
		.main-content {
			padding: 1rem 0.5rem 0.5rem 0.5rem;
		}

		.hero-section {
			margin-bottom: 2rem;
		}

		.services-container {
			grid-template-columns: 1fr;
			grid-auto-rows: auto;
			padding: 0;
			gap: 1.5rem;
		}
		
		.service-card {
			padding: 1.5rem;
			height: auto;
		}
		
		.service-card h2 {
			font-size: 1.2rem;
			text-align: left;
			margin-bottom: 1rem;
		}
		
		.service-card li {
			padding: 0.6rem 0;
			font-size: 0.9rem;
			padding-left: 1.25rem;
			margin-bottom: 0.25rem;
		}
		
		.service-card li::before {
			top: 0.6rem;
		}
	}

	/* Mobile pequeño */
	@media (max-width: 480px) {
		.main-content {
			padding: 1rem 0.5rem 0.5rem 0.5rem;
		}

		.hero-section {
			margin-bottom: 1.5rem;
		}

		.services-container {
			padding: 0 0.5rem;
			gap: 1rem;
		}
		
		.service-card {
			padding: 1.25rem;
		}
		
		.service-card h2 {
			font-size: 1.1rem;
		}
		
		.service-card li {
			font-size: 0.85rem;
			padding: 0.5rem 0;
			padding-left: 1rem;
			margin-bottom: 0.25rem;
		}
		
		.service-card li::before {
			top: 0.5rem;
			font-size: 0.7rem;
		}
	}

	/* ===== HIGH CONTRAST MODE ===== */
	@media (prefers-contrast: high) {
		.service-card {
			background: #FFFFFF;
			border: 2px solid #000000;
		}
		
		.service-card h2 {
			color: #000000;
		}
		
		.service-card li {
			color: #000000;
		}
		
		.service-card li::before {
			color: #000000;
		}
	}

	/* ===== PRINT STYLES ===== */
	@media print {
		.service-card {
			break-inside: avoid;
			box-shadow: none;
			border: 1px solid #000000;
			background: #FFFFFF;
		}
		
		.service-card h2, .service-card li {
			color: #000000;
		}
	}
</style>